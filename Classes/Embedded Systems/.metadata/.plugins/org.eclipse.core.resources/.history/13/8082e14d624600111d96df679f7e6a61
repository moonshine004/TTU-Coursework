/**
  * @brief  Function implementing the CliTask thread.
  * @param  argument: Not used
  * @retval None
  */
/* USER CODE END Header_StartCliTask */
void StartCliTask(void *argument)
{
  /* USER CODE BEGIN 5 */

  char rxChar;
  char cmdBuffer[80];
  uint8_t index = 0;

  uartWriteLine("\033[2J\033[H");
  uartWriteLine("STM32F429 WAVE Player CLI");
  uartWriteLine("Type /help");
  printPrompt();

  for(;;)
  {
    HAL_UART_Receive(&huart1, (uint8_t *)&rxChar, 1, HAL_MAX_DELAY);

    if (rxChar == '\r' || rxChar == '\n')
    {
      uartWriteLine("");

      cmdBuffer[index] = '\0';

      if (index > 0)
      {
        uartWriteLine(cmdBuffer);   // temporary: echoes full command
      }

      index = 0;
      printPrompt();
    }
    else if (rxChar == '\b' || rxChar == 127)
    {
      if (index > 0)
      {
        index--;
        uartWrite("\b \b");
      }
    }
    else
    {
      if (index < sizeof(cmdBuffer) - 1)
      {
        cmdBuffer[index++] = rxChar;
        HAL_UART_Transmit(&huart1, (uint8_t *)&rxChar, 1, HAL_MAX_DELAY);
      }
    }
  }

  /* USER CODE END 5 */
}

