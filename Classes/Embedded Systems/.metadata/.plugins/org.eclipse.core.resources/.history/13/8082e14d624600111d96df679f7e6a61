static void uartWrite(const char *msg)
{
    osMutexAcquire(uartLockHandle, osWaitForever);
    HAL_UART_Transmit(&huart1, (uint8_t *)msg, strlen(msg), HAL_MAX_DELAY);
    osMutexRelease(uartLockHandle);
}

static void uartWriteLine(const char *msg)
{
    uartWrite(msg);
    uartWrite("\r\n");
}

