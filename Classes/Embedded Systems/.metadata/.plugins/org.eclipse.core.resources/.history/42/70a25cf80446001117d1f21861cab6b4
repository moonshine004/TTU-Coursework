/* USER CODE BEGIN 0 */
void GenerateSineWave()
{
    for (int i = 0; i < TABLE_SIZE; i++)
    {
        float angle = (2.0f * M_PI * i) / TABLE_SIZE;

        float value = (sinf(angle) + 1.0f) * 2047.5f;

        value = (value * gainPercent) / 100.0f;

        wavetable64[i] = (uint16_t)value;
    }
}

void UpdateFrequency(uint32_t freq)
{
    if (freq < 20 || freq > 10000)
    {
        HAL_TIM_Base_Stop(&htim7);
        return;
    }

    toneHz = freq;

    uint32_t timerClock = 84000000;
    uint32_t sampleRate = freq * TABLE_SIZE;
    uint32_t newARR = (timerClock / sampleRate) - 1;

    __HAL_TIM_SET_AUTORELOAD(&htim7, newARR);

    HAL_TIM_Base_Start(&htim7);
}

void UpdateAmplitude(uint32_t amp)
{
    if (amp > 100)
        amp = 100;

    gainPercent = amp;

    GenerateSineWave();
}
