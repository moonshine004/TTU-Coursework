/* USER CODE BEGIN Header_StartCommandTask */
/**
  * @brief  Function implementing the commandTask thread.
  * @param  argument: Not used
  * @retval None
  */
void StartCommandTask(void *argument)
{
  /* init code for USB_HOST */
  MX_USB_HOST_Init();

  GenerateSineWave();

  HAL_TIM_Base_Start(&htim7);

  HAL_DAC_Start_DMA(&hdac,
                    DAC_CHANNEL_2,
                    (uint32_t*)wavetable64,
                    TABLE_SIZE,
                    DAC_ALIGN_12B_R);

  HAL_TIM_Base_Stop(&htim7);

  /* USER CODE BEGIN 5 */
  char rx;
  char buffer[100];
  int idx = 0;

  playSemHandle = osSemaphoreNew(1, 0, NULL);
  osSemaphoreAcquire(playSemHandle, 0);

  char readyMsg[] = "\r\nCLI Ready. Type /help\r\n";
  HAL_UART_Transmit(&huart1, (uint8_t*)readyMsg, strlen(readyMsg), 100);

  for(;;)
  {
    if (HAL_UART_Receive(&huart1, (uint8_t*)&rx, 1, HAL_MAX_DELAY) == HAL_OK)
    {
      if (rx == '\b' || rx == 127)
      {
        if (idx > 0)
        {
          idx--;
          HAL_UART_Transmit(&huart1, (uint8_t*)"\b \b", 3, 100);
        }
      }
      else if (rx == '\r' || rx == '\n')
      {
        HAL_UART_Transmit(&huart1, (uint8_t*)"\r\n", 2, 100);

        buffer[idx] = '\0';

        if (strcmp(buffer, "/help") == 0)
        {
          char helpMsg[] =
            "Commands:\r\n"
            "/help\r\n"
            "/about\r\n"
            "/clear\r\n"
            "/sine set freq <20-10000>\r\n"
            "/sine set amp <0-100>\r\n"
            "/sine ramp <start>,<step>,<stop>\r\n"
            "/playtest\r\n";
          HAL_UART_Transmit(&huart1, (uint8_t*)helpMsg, strlen(helpMsg), 300);
        }
        else if (strcmp(buffer, "/about") == 0)
        {
          char aboutMsg[] =
            "Project 5 Audio CLI\r\n"
            "Amna Malik - R11827604\r\n"
            "STM32F429 + BOOST-XL Audio\r\n"
            "DAC + DMA sine wave control\r\n"
            "Build: " __DATE__ " " __TIME__ "\r\n";
          HAL_UART_Transmit(&huart1, (uint8_t*)aboutMsg, strlen(aboutMsg), 300);
        }
        else if (strcmp(buffer, "/clear") == 0)
        {
          char clearMsg[] = "\033[2J\033[H";
          HAL_UART_Transmit(&huart1, (uint8_t*)clearMsg, strlen(clearMsg), 100);
        }
        else if (strncmp(buffer, "/sine set freq ", 15) == 0)
        {
          uint32_t f = atoi(&buffer[15]);
          UpdateFrequency(f);
        }
        else if (strncmp(buffer, "/sine set amp ", 14) == 0)
        {
          uint32_t a = atoi(&buffer[14]);
          UpdateAmplitude(a);
        }
        else if (strncmp(buffer, "/sine ramp ", 11) == 0)
        {
          sscanf(&buffer[11], "%lu,%lu,%lu",
                 &sweepStartHz,
                 &sweepStepHz,
                 &sweepStopHz);

          if (sweepStartHz >= 20 && sweepStopHz <= 10000 && sweepStepHz > 0)
          {
            osSemaphoreRelease(freqRampSemHandle);
          }
          else
          {
            HAL_TIM_Base_Stop(&htim7);
            char badRampMsg[] = "Invalid ramp. Use: /sine ramp <20-10000>,<step>,<20-10000>\r\n";
            HAL_UART_Transmit(&huart1, (uint8_t*)badRampMsg, strlen(badRampMsg), 300);
          }
        }
        else if (strcmp(buffer, "/playtest") == 0)
        {
          playMode = 1;
          osSemaphoreRelease(playSemHandle);
        }
        else if (strcmp(buffer, "/playtest2") == 0)
        {
          playMode = 2;
          osSemaphoreRelease(playSemHandle);
        }
        else
        {
          char invalidMsg[] = "Invalid command. Type /help\r\n";
          HAL_UART_Transmit(&huart1, (uint8_t*)invalidMsg, strlen(invalidMsg), 200);
        }

        idx = 0;
      else
      {
        if (idx < sizeof(buffer) - 1)
        {
          buffer[idx++] = rx;
          HAL_UART_Transmit(&huart1, (uint8_t*)&rx, 1, 100);
        }
      }
    }
  }
  /* USER CODE END 5 */
  }

/* USER CODE BEGIN Header_StartFreqSweepTask */
/**
* @brief Function implementing the freqSweepTask thread.
* @param argument: Not used
* @retval None
*/
void StartFreqSweepTask(void *argument)
{
  /* USER CODE BEGIN StartFreqSweepTask */
  for(;;)
  {
    osSemaphoreAcquire(freqRampSemHandle, osWaitForever);

    for (uint32_t f = sweepStartHz; f <= sweepStopHz; f += sweepStepHz)
    {
      UpdateFrequency(f);

      // one full wave: T = 1/f seconds → (1000/f) ms
      uint32_t delayMs = (1000 / f) * 50;

      if (delayMs == 0)
      {
        delayMs = 1; // prevent 0 delay at high freq
      }

      osDelay(delayMs);
    }

    HAL_TIM_Base_Stop(&htim7);
  }
  /* USER CODE END StartFreqSweepTask */
}

/* USER CODE BEGIN Header_StartPlayTask */
/**
* @brief Function implementing the playTask thread.
* @param argument: Not used
* @retval None
*/
/* USER CODE END Header_StartPlayTask */
void StartPlayTask(void *argument)
{
  /* USER CODE BEGIN StartPlayTask */
  for(;;)
  {
    while (playSemHandle == NULL)
    {
      osDelay(10);
    }

    if (osSemaphoreAcquire(playSemHandle, osWaitForever) == osOK)
    {
      char playMsg[] = "playing\r\n";
      HAL_UART_Transmit(&huart1, (uint8_t*)playMsg, strlen(playMsg), 100);

      uint32_t *notes;
      uint32_t *durations;
      uint32_t length;

      if (playMode == 2)
      {
        notes = melody2Notes;
        durations = melody2Durations;
        length = melody2Length;
      }
      else
      {
        notes = melodyNotes;
        durations = melodyDurations;
        length = melodyLength;
      }

      for (uint32_t i = 0; i < length; i++)
      {
        if (notes[i] == 0)
        {
          HAL_TIM_Base_Stop(&htim7);
        }
        else
        {
          UpdateFrequency(notes[i]);
        }

        osDelay(durations[i]);
      }

      HAL_TIM_Base_Stop(&htim7);

      char doneMsg[] = "done\r\n";
      HAL_UART_Transmit(&huart1, (uint8_t*)doneMsg, strlen(doneMsg), 100);
    }
  }
  /* USER CODE END StartPlayTask */
}
