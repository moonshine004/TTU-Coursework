/* USER CODE BEGIN Application */
void SetSineFrequency(uint32_t freq)
{
    if (freq < 20 || freq > 10000)
    {
        HAL_TIM_Base_Stop(&htim6);
        return;
    }

    uint32_t timer_clock = 84000000;
    uint32_t update_rate = freq * 64;

    uint32_t prescaler = 0;
    uint32_t period = (timer_clock / update_rate) - 1;

    __HAL_TIM_SET_PRESCALER(&htim6, prescaler);
    __HAL_TIM_SET_AUTORELOAD(&htim6, period);

    HAL_TIM_Base_Start(&htim6);
}
/* USER CODE END Application */
