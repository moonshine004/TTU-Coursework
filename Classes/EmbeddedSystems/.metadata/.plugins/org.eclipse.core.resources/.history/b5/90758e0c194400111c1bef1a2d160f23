/* USER CODE BEGIN Header_StartDefaultTask */
/**
  * @brief  Function implementing the defaultTask thread.
  * @param  argument: Not used
  * @retval None
  */
/* USER CODE END Header_StartDefaultTask */
void StartDefaultTask(void const * argument)
{
  /* init code for USB_HOST */
  MX_USB_HOST_Init();
  /* USER CODE BEGIN StartDefaultTask */

  char msg[] = "Default task started\r\n";
  osMutexWait(uartMutexHandle, osWaitForever);
  HAL_UART_Transmit(&huart1, (uint8_t*)msg, strlen(msg), 100);
  osMutexRelease(uartMutexHandle);

  HAL_GPIO_WritePin(ACP_RST_GPIO_Port, ACP_RST_Pin, GPIO_PIN_SET);

  // 🔥 START TIMER + DAC DMA (SINE WAVE)
  HAL_TIM_Base_Start(&htim6);

  HAL_DAC_Start_DMA(&hdac,
                    DAC_CHANNEL_1,
                    (uint32_t*)sineTable,
                    64,
                    DAC_ALIGN_12B_R);

  char rx;
  char buffer[100];
  int idx = 0;

  char startMsg[] = "CLI Ready\r\n";
  osMutexWait(uartMutexHandle, osWaitForever);
  HAL_UART_Transmit(&huart1, (uint8_t*)startMsg, strlen(startMsg), 100);
  osMutexRelease(uartMutexHandle);

  for(;;)
  {
      HAL_UART_Receive(&huart1, (uint8_t*)&rx, 1, HAL_MAX_DELAY);

      if (rx == 127 || rx == '\b')
      {
          if (idx > 0)
          {
              idx--;

              char bs[] = "\b \b";
              osMutexWait(uartMutexHandle, osWaitForever);
              HAL_UART_Transmit(&huart1, (uint8_t*)bs, strlen(bs), 100);
              osMutexRelease(uartMutexHandle);
          }
      }
      else if (rx == '\r' || rx == '\n')
      {
          buffer[idx] = '\0';

          char newline[] = "\r\n";
          osMutexWait(uartMutexHandle, osWaitForever);
          HAL_UART_Transmit(&huart1, (uint8_t*)newline, strlen(newline), 100);
          osMutexRelease(uartMutexHandle);

          if (strcmp(buffer, "/help") == 0)
          {
              char helpMsg[] = "Commands: /help\r\n";
              osMutexWait(uartMutexHandle, osWaitForever);
              HAL_UART_Transmit(&huart1, (uint8_t*)helpMsg, strlen(helpMsg), 100);
              osMutexRelease(uartMutexHandle);
          }
          else
          {
              char unknownMsg[] = "Unknown command\r\n";
              osMutexWait(uartMutexHandle, osWaitForever);
              HAL_UART_Transmit(&huart1, (uint8_t*)unknownMsg, strlen(unknownMsg), 100);
              osMutexRelease(uartMutexHandle);
          }

          idx = 0;
      }
      else
      {
          osMutexWait(uartMutexHandle, osWaitForever);
          HAL_UART_Transmit(&huart1, (uint8_t*)&rx, 1, 100);
          osMutexRelease(uartMutexHandle);

          buffer[idx++] = rx;

          if (idx >= 99)
              idx = 0;
      }
  }

  /* USER CODE END StartDefaultTask */
}

