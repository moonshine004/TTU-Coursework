package ls_project_two;

import java.util.*;

public class Enrollment {
    private static HashMap<String, Student> studentMap = new HashMap<>();
    private static HashMap<String, Course> courseMap = new HashMap<>();

    private static PriorityQueue<Course> courseSchedule = new PriorityQueue<>(
        (c1, c2) -> Integer.compare(c2.getEnrollmentCount(), c1.getEnrollmentCount())
    );

    public static void addStudent(Student student) {
        studentMap.put(student.getStudentId(), student);
    }

    public static void addCourse(Course course) {
        courseMap.put(course.getCourseId(), course);
        courseSchedule.add(course);
    }

    public static void enrollStudent(String studentId, String courseId) {
        if (studentMap.containsKey(studentId) && courseMap.containsKey(courseId)) {
            Course course = courseMap.get(courseId);
            if (course.enrollStudent(studentId)) {
                System.out.println("Enrolled successfully!");
            } else {
                System.out.println("Course full.");
            }
        } else {
            System.out.println("Student or Course not found.");
        }
    }

    public static void dropStudent(String studentId, String courseId) {
        if (courseMap.containsKey(courseId)) {
            Course course = courseMap.get(courseId);
            if (course.dropStudent(studentId)) {
                System.out.println("Dropped successfully!");
            } else {
                System.out.println("Student not enrolled in course.");
            }
        }
    }

    public static void displayStudents() {
        for (Student s : studentMap.values()) {
            s.displayInfo();
        }
    }

    public static void displayCourses() {
        for (Course c : courseMap.values()) {
            c.displayInfo();
        }
    }

    public static void displayCourseSchedule() {
        System.out.println("\nCourse Schedule (by popularity):");
        PriorityQueue<Course> temp = new PriorityQueue<>(courseSchedule);
        while (!temp.isEmpty()) {
            temp.poll().displayInfo();
        }
    }

    public static void main(String[] args) {
        addStudent(new Student("S001", "Alice", 20, "CS"));
        addStudent(new Student("S002", "Bob", 21, "Math"));

        addCourse(new Course("C001", "Intro to Java", "Dr. Smith", 2));
        addCourse(new Course("C002", "Data Structures", "Dr. Jones", 2));

        enrollStudent("S001", "C001");
        enrollStudent("S002", "C001");
        enrollStudent("S002", "C002");

        displayStudents();
        displayCourses();
        displayCourseSchedule();
    }
}
